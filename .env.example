# After changing this file, restart Expo completely (stop npm start, then start again).
# Android emulator → http://10.0.2.2:3001/api/v1
# iOS Simulator   → http://localhost:3001/api/v1
# Physical device → http://<LAN-IP>:3001/api/v1  (macOS: ipconfig getifaddr en0)
# Production EC2  → http://<EC2_PUBLIC_IP>/mobile/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api/v1

# Analytics & Monitoring
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=

# Google Sign-In (OAuth client ID from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# RevenueCat (Public SDK keys from the RevenueCat dashboard — Project Settings > API Keys).
# Purchases are a no-op until these are set (see shared/services/purchases.ts).
# Also requires: products created in App Store Connect / Google Play Console, matching
# products configured in the RevenueCat dashboard, and an offering with monthly/annual/
# lifetime packages set as "current".
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
